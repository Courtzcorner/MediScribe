# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# ── Amazon Bedrock Models ─────────────────────────────────────────────────────
# Claude Sonnet 4.6 via Bedrock for medical analysis
BEDROCK_CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
# Amazon Nova Sonic for speech-to-text
BEDROCK_NOVA_MODEL_ID=amazon.nova-sonic-v1:0
# Amazon Transcribe (alternative STT)
TRANSCRIBE_LANGUAGE_CODE=en-US

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mediscribe:password@localhost:5432/mediscribe
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis (Celery broker + cache) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── S3 Storage ───────────────────────────────────────────────────────────────
S3_BUCKET_NAME=mediscribe-audio-recordings
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=3600

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Next.js Public Vars (prefix with NEXT_PUBLIC_) ───────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
